# Copiá a .env para local. En Railway seteá las mismas variables en el servicio.

# --- MySQL (Railway MySQL plugin inyecta MYSQLHOST, MYSQLUSER, etc.) ---
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=auth_db
MYSQLUSER=root
MYSQLPASSWORD=1234
MYSQL_SSL=false
# DB_POOL_MAX=8
# DB_POOL_MIN=0

# --- JWT (en producción: secreto fuerte, mínimo 32 caracteres) ---
JWT_SECRET=local-dev-only-secret-key-32-chars-min
JWT_ISSUER=auth-base
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P14D

# --- HTTP / Front ---
PORT=8080
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# --- Admin inicial (solo si la tabla users está vacía) ---
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=Admin1234!
AUTH_BOOTSTRAP_ADMIN_NAME=Administrador
AUTH_BOOTSTRAP_ADMIN_LAST_NAME=Admin

# --- Auth extras (opcionales) ---
# AUTH_MAX_FAILED_ATTEMPTS=5
# AUTH_LOCK_DURATION=PT15M
# PASSWORD_RESET_TTL=PT30M
# SWAGGER_ENABLED=false

# --- Mail ---
# Local (Mailpit):
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_START_TLS=DISABLED
# MAIL_LOGIN=DISABLED
# MAIL_FROM=Auth Base <noreply@localhost>

# Brevo / SMTP real (solo local o hosts que permitan salida 587):
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_START_TLS=REQUIRED
MAIL_LOGIN=REQUIRED
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Auth Base <noreply@tudominio.com>

# Railway: preferí la API HTTP (puerto 443). Si BREVO_API_KEY está seteada, se usa en vez de SMTP.
# Brevo → SMTP & API → API Keys → Generate a new API key
# BREVO_API_KEY=
